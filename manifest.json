{
  "manifest_version": 3,
  "name": "Adsterra Code Exporter",
  "version": "2.1.2",
  "description": "One-click copy of all ad codes for a website on the Adsterra publishers Websites page.",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.adsterra.com/*",
    "*://*.adsterra.cc/*",
    "*://*.adsterra.cfd/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.adsterra.com/*",
        "*://*.adsterra.cc/*",
        "*://*.adsterra.cfd/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
